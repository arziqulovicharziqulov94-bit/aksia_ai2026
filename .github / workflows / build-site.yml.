name: Saytni qurish va joylash

# Har ish kuni AQSh bozori yopilgandan keyin sayt qayta quriladi va GitHub Pages'ga joylanadi.
# Qo'lda ishga tushirish: Actions -> "Saytni qurish va joylash" -> Run workflow (xohlasangiz yangi tikerlarni yozing).
on:
  schedule:
    - cron: "30 22 * * 1-5"        # 22:30 UTC (Toshkent: ertasi kuni 03:30), dushanba-juma
  workflow_dispatch:
    inputs:
      tickers:
        description: "Qo'shimcha tikerlar (vergul bilan), masalan: PLTR, SOFI — doimiy saqlanadi"
        required: false
        default: ""
  push:
    branches: [main]
    paths:
      - "extra_tickers.txt"
      - "app.py"
      - "build_site.py"
      - "requirements.txt"
      - ".github/workflows/build-site.yml"

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    permissions:
      contents: write              # faqat qo'lda kiritilgan tikerlarni extra_tickers.txt ga saqlash uchun
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip

      - name: Kutubxonalarni o'rnatish
        run: pip install -r requirements.txt

      - name: Ma'lumot manbalarini tekshirish
        run: python app.py --check-data

      - name: Yangi tikerlarni saqlash
        if: ${{ github.event_name == 'workflow_dispatch' && github.event.inputs.tickers != '' }}
        env:
          NEW_TICKERS: ${{ github.event.inputs.tickers }}
        run: |
          python build_site.py --save-extras "$NEW_TICKERS"
          if ! git diff --quiet -- extra_tickers.txt; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add extra_tickers.txt
            git commit -m "Qo'shimcha tikerlar qo'shildi"
            git push
          fi

      - name: Saytni qurish
        env:
          AKSIYA_FALLBACK_SECONDS: "900"
        run: python build_site.py --out site

      - uses: actions/upload-pages-artifact@v3
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v5
